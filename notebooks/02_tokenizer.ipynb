import pandas as pd
import numpy as np
import tensorflow as tf

train = pd.read_csv('../data/processed/train.csv')
val = pd.read_csv('../data/processed/val.csv')
print("Train:", train.shape)
print("Val:", val.shape)
lengths = train['clean_text'].apply(lambda x: len(x.split()))
lengths.describe()
print("Average words per tweet:", lengths.mean().round(1))
print("Max words:", lengths.max())
print("90th percentile:", np.percentile(lengths, 90))
MAX_TOKENS = 20000
MAX_LENGTH = 25

vectorizer = tf.keras.layers.TextVectorization(
    max_tokens=MAX_TOKENS,
    output_mode='int',
    output_sequence_length=MAX_LENGTH
)

# Adapt on training text only
vectorizer.adapt(train['clean_text'].values)

print("Vocabulary size:", len(vectorizer.get_vocabulary()))
print("\nFirst 20 words in vocab:")
print(vectorizer.get_vocabulary()[:20])
test_sentence = ["yaar ye phone ekdum bekar hai total waste of money"]
print(vectorizer(test_sentence))
# Convert labels to numpy arrays
import numpy as np

train_labels = np.array(train['label'])
val_labels = np.array(val['label'])

print("Train labels shape:", train_labels.shape)
print("Val labels shape:", val_labels.shape)
print("Unique labels:", np.unique(train_labels))
BATCH_SIZE = 32

train_dataset = tf.data.Dataset.from_tensor_slices(
    (train['clean_text'].values, train_labels)
).batch(BATCH_SIZE).prefetch(tf.data.AUTOTUNE)

val_dataset = tf.data.Dataset.from_tensor_slices(
    (val['clean_text'].values, val_labels)
).batch(BATCH_SIZE).prefetch(tf.data.AUTOTUNE)

print("Train batches:", len(train_dataset))
print("Val batches:", len(val_dataset))
