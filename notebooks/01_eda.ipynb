# Load all three splits with correct column names
train = pd.read_csv('../data/raw/FinalTrainingOnly.tsv', sep='\t', header=None, names=['uid', 'text', 'label'])
val = pd.read_csv('../data/raw/ValidationOnly.tsv', sep='\t', header=None, names=['uid', 'text', 'label'])
test = pd.read_csv('../data/raw/FinalTest.tsv', sep='\t', header=None, names=['uid', 'text'])

print("Train shape:", train.shape)
print("Val shape:", val.shape)
print("Test shape:", test.shape)
train['label'].value_counts()
# Look at text for each label to figure out the mapping
for label in [0, 1, 2]:
    print(f"\n--- Label {label} ---")
    print(train[train['label'] == label]['text'].head(3).tolist())
# Map numeric labels to text
label_map = {0: 'negative', 1: 'positive', 2: 'neutral'}
train['sentiment'] = train['label'].map(label_map)
val['sentiment'] = val['label'].map(label_map)

# Confirm
print(train['sentiment'].value_counts())
import re

def clean_text(text):
    # Handle missing values
    if not isinstance(text, str):
        return ''
    # Remove @mentions
    text = re.sub(r'@\w+', '', text)
    # Remove URLs
    text = re.sub(r'http\S+|www\S+', '', text)
    # Remove "nan" at end (artifact in this dataset)
    text = re.sub(r'\bnan\b', '', text)
    # Remove special characters but keep letters, numbers, spaces
    text = re.sub(r'[^a-zA-Z0-9\s]', '', text)
    # Remove extra whitespace
    text = re.sub(r'\s+', ' ', text).strip()
    # Lowercase
    text = text.lower()
    return text

# Apply to all splits
train['clean_text'] = train['text'].apply(clean_text)
val['clean_text'] = val['text'].apply(clean_text)

# See before vs after
for i in range(3):
    print(f"BEFORE: {train['text'].iloc[i]}")
    print(f"AFTER:  {train['clean_text'].iloc[i]}")
    print()
# Check for empty strings after cleaning
print("Empty rows in train:", (train['clean_text'] == '').sum())
print("Empty rows in val:", (val['clean_text'] == '').sum())

# Drop empty rows
train = train[train['clean_text'] != ''].reset_index(drop=True)
val = val[val['clean_text'] != ''].reset_index(drop=True)

# Final shape
print("\nFinal train shape:", train.shape)
print("Final val shape:", val.shape)
# Save cleaned data
import os
os.makedirs('../data/processed', exist_ok=True)

# Now save
train[['clean_text', 'label', 'sentiment']].to_csv('../data/processed/train.csv', index=False)
val[['clean_text', 'label', 'sentiment']].to_csv('../data/processed/val.csv', index=False)

